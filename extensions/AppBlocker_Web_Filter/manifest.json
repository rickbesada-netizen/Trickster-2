{
  "manifest_version": 3,
  "name": "AppBlocker Web Filter",
  "version": "1.0.1",
  "description": "Enforces AppBlocker's website allow-list. Managed by AppBlocker.",
  "key": "",
  "permissions": ["webNavigation", "tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47113/*"],
  "action": { "default_popup": "popup.html", "default_title": "AppBlocker Web Filter" },
  "background": { "service_worker": "background.js" }
}
